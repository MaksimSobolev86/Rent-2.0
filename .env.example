# Скопируйте в .env и подставьте пароль пользователя postgres.
DATABASE_URL=postgres://postgres:YOUR_PASSWORD@localhost:5432/rent_db

# Опционально (по умолчанию 3000)
# PORT=3000

# Секрет для JWT-сессии владельца (обязательно сменить в проде)
# JWT_SECRET=change-me-in-production
# Альтернативное имя (если JWT_SECRET не задан): SESSION_SECRET

# Режим Node (production отключает mock-заголовки x-user-id / x-user-role)
# NODE_ENV=development

# Разрешить mock-авторизацию в production (только если осознанно нужно для отладки)
# ALLOW_MOCK_AUTH=false

# Публичный URL бэкенда (для абсолютных ссылок на /uploads в VK и админке)
# PUBLIC_BASE_URL=http://localhost:3000

# Загрузка изображений (опционально)
# UPLOADS_DIR=uploads
# UPLOAD_MAX_INPUT_BYTES=15728640
# UPLOAD_MAX_EDGE=1600
# UPLOAD_WEBP_QUALITY=80
# Баннеры спецпредложений: 315×130 на экране, файл 630×260 (2×), качество WebP
# PROMO_PIXEL_RATIO=2
# PROMO_WEBP_QUALITY=90
